# Скопируй в .env и заполни реальными значениями (.env уже в .gitignore).

# Официальный OpenAI — для llm_as_judge.py (генерация вопроса + судейство),
# бэкенд "OpenAI (gpt-5-nano)" в разделе Оценка / lora_peft/app.py.
OPENAI_TOKEN=

# Токен внутреннего OpenAI-совместимого сервера (10.246.6.82:8080, minimax/minimax-m3).
# Многие self-hosted серверы его не проверяют — тогда можно оставить пустым,
# llm_as_judge.py в этом случае подставит "not-needed".
INTERNAL_API_TOKEN=

# Ключ Weights & Biases (https://wandb.ai/authorize), нужен, чтобы finetune.py/
# bertscore.py/llm_as_judge.py могли логировать метрики.
WANDB_API_KEY=

# Имя пользователя/команды W&B (entity) — то, что стоит после wandb.ai/ в
# адресе проекта. Нужен, чтобы вкладка "W&B" в lora_peft/app.py могла
# построить прямую ссылку на дашборд проекта.
WANDB_ENTITY=

# Опционально: адрес self-hosted W&B Server (on-prem), если не используется
# облачный wandb.ai. Пример: https://wandb.mycompany.internal
WANDB_BASE_URL=
