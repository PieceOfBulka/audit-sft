# Скопируй в .env и заполни реальными значениями (.env уже в .gitignore).

# Официальный OpenAI — для llm_as_judge.py (генерация вопроса + судейство),
# бэкенд "OpenAI (gpt-5-nano)" в разделе Оценка / lora_peft/app.py.
OPENAI_TOKEN=

# Токен внутреннего OpenAI-совместимого сервера (10.246.6.82:8080, minimax/minimax-m3).
# Многие self-hosted серверы его не проверяют — тогда можно оставить пустым,
# llm_as_judge.py в этом случае подставит "not-needed".
INTERNAL_API_TOKEN=

# Адрес веб-интерфейса self-hosted MLflow (mlflow server / mlflow ui),
# для вкладки "MLflow" в lora_peft/app.py. Обычно порт 5000.
# Пример: http://10.x.x.x:5000
MLFLOW_WEB_HOST=

# Опционально: если MLflow-сервер поднят не на localhost, finetune.py/
# bertscore.py/llm_as_judge.py должны писать метрики именно туда — иначе
# mlflow по умолчанию пишет в локальную папку ./mlruns на машине, где
# запущен скрипт. Пример: http://10.x.x.x:5000
MLFLOW_TRACKING_URI=
