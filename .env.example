# Скопируй в .env и заполни реальными значениями (.env уже в .gitignore).

# Официальный OpenAI — для llm_as_judge.py (генерация вопроса + судейство),
# бэкенд "OpenAI (gpt-5-nano)" в разделе Оценка / lora_peft/app.py.
OPENAI_TOKEN=

# Токен внутреннего OpenAI-совместимого сервера (10.246.6.82:8080, minimax/minimax-m3).
# Многие self-hosted серверы его не проверяют — тогда можно оставить пустым,
# llm_as_judge.py в этом случае подставит "not-needed".
INTERNAL_API_TOKEN=
